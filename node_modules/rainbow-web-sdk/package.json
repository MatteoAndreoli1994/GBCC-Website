{
    "name": "rainbow-web-sdk",
    "version": "5.0.36-sts",
    "description": "",
    "type": "module",
    "main": "lib/cjs/index.js",
    "module": "lib/index.js",
    "umd": "lib/index.umd.js",
    "types": "lib/",
    "files": [
        "/lib/**"
    ],
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js",
            "require": "./lib/cjs/index.js"
        },
        "./*": {
            "types": "./lib/*",
            "import": "./lib/index.js",
            "require": "./lib/cjs/index.js"
        }
    },
    "sideEffects": [
        "./src/libs/strophe/**/*.js",
        "./src/strophejs.ts"
    ],
    "scripts": {
        "clean": "rimraf lib test/dist stats",
        "build": "node esbuild.config.mjs",
        "build-dev": "ESM_ONLY=1 node esbuild.config.mjs",
        "build-prod": "NODE_ENV=production node esbuild.config.mjs",
        "build-rollup": "rollup -c rollup.config.cjs && tsc-alias",
        "lint": "eslint ./src",
        "docs": "rimraf docs-out; typedoc --options typedoc.json && cp -R docs/* docs-out",
        "apiDocsLTS": "rimraf buildAPIDoc; typedoc --options typedocLTS.json",
        "apiDocsSTS": "rimraf buildAPIDoc; typedoc --options typedocSTS.json",
        "apiDocs999": "rimraf build999/api; typedoc --options typedoc999.json",
        "apiDocsLocal": "rimraf buildLocal/api; typedoc --options typedocLocal.json",
        "windocs": "typedoc --options typedoc.json",
        "typecheck": "tsc && tsc-strict",
        "sitemap": "node ./scripts/sitemap_generation.cjs"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "crypto-es": "^2.1.0",
        "date-fns": "=4.1.0",
        "flatted": "^3.3.1",
        "jwt-decode": "=4.0.0",
        "lodash-es": "^4.17.21",
        "module-alias": "^2.2.3",
        "rxjs": "~7.8.1"
    },
    "devDependencies": {
        "@droppedcode/typedoc-plugin-relative-includes": "^1.0.5",
        "@eslint/js": "^9.9.1",
        "@knodes/typedoc-plugin-code-blocks": "^0.23.4",
        "@rollup/plugin-commonjs": "^26.0.1",
        "@rollup/plugin-node-resolve": "^15.2.3",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^11.1.6",
        "@types/dom-mediacapture-transform": "^0.1.9",
        "@types/eslint__js": "^8.42.3",
        "@types/jquery": "^3.5.30",
        "@types/lodash-es": "^4.17.12",
        "@types/strophe.js": "^1.4.6",
        "esbuild": "^0.24.0",
        "esbuild-clean-plugin": "^1.0.0",
        "esbuild-plugin-d.ts": "^1.3.0",
        "eslint": "^9.9.1",
        "js-yaml": "^4.1.0",
        "renamer": "^5.0.2",
        "rimraf": "^6.0.1",
        "rollup": "^4.21.2",
        "rollup-plugin-analyzer": "^4.0.0",
        "rollup-plugin-dts": "^6.1.1",
        "rollup-plugin-sourcemaps": "^0.6.3",
        "rollup-plugin-typescript2": "^0.36.0",
        "rollup-plugin-visualizer": "^5.12.0",
        "tsc-alias": "^1.8.10",
        "tslib": "^2.6.3",
        "typedoc": "=0.25.13",
        "typedoc-material-theme": "^1.1.0",
        "typedoc-plugin-expand-object-like-types": "=0.1.2",
        "typedoc-plugin-markdown": "=4.0.3",
        "typedoc-plugin-mdn-links": "=3.1.29",
        "typedoc-plugin-merge-modules": "=5.1.0",
        "typedoc-plugin-missing-exports": "=2.2.0",
        "typedoc-plugin-reference-excluder": "=1.1.3",
        "typescript": "~5.5.4",
        "typescript-eslint": "^8.4.0",
        "typescript-strict-plugin": "=2.4.4"
    }
}